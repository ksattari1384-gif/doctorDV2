# ═══════════════════════════════════════════════════════
#  Qarahdaghi Dental — Environment Variables (Example)
#  این فایل نمونه‌ست. برای استفاده واقعی:
#    cp .env.example .env.local
#  و مقادیر واقعی رو داخل .env.local بذار.
#  .env.local توی .gitignore هست و پوش نمی‌شه.
# ═══════════════════════════════════════════════════════

# ─── App ───────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth (Auth.js v5) ─────────────────────────────────
# این مقدار رو با این دستور بساز:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-a-long-random-secret
AUTH_TRUST_HOST=true

# ─── Database ──────────────────────────────────────────
# برای فاز توسعه روی Cloudflare از D1 استفاده می‌کنیم (توی wrangler.toml تنظیم می‌شه)
# برای VPS نهایی از PostgreSQL استفاده می‌کنیم:
# DATABASE_URL=postgres://dental:password@localhost:5432/dental

# ─── Object Storage (R2 روی Cloudflare / MinIO روی VPS) ──
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=dental-media
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ─── SMS (Kavenegar) ───────────────────────────────────
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ─── Payment (Zarinpal) ────────────────────────────────
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:3000/api/payments/zarinpal/callback

# ─── AI Agent ──────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1